   :accent   ["#7A63DC" "#EDBE6A"]
   :store    {:name "Microsoft Store"
              :url  "https://apps.microsoft.com/detail/9PMP1591Q78R"
              :note "Windows 10 and 11 · x64 and Arm64"}}]

 ;; Feedback and support in the open: GitHub Discussions and issues in this
 ;; repository, where we reply. Each :discussion is a category's slug (its
 ;; form is .github/DISCUSSION_TEMPLATE/<slug>.yml); an :issue-form is a
 ;; file in .github/ISSUE_TEMPLATE/. The README's "Feedback" says how
 ;; Discussions are set up.
 :feedback
 {:repo     "https://github.com/EchoJustus/clogem-support"
  :title    "Feedback & support"
  :lead     "Ask, suggest and report on GitHub, in the open. We reply there, and every answer helps the next person too."
  :channels [{:badge      "Ideas"
              :title      "Share feedback or an idea"
              :about      "What works for you, what doesn't, and what you would like next."
              :discussion "ideas"
              :action     "Start a discussion"}
             {:badge      "Q&A"
              :title      "Ask a question"
              :about      "How to do something, or why an app did what it did."
              :discussion "q-a"
              :action     "Ask a question"}
             {:badge      "Bug"
              :title      "Report a bug"
              :about      "Something broke or looks wrong: tell us the app, its version and the steps."
              :issue-form "bug-report.yml"
              :action     "Report a bug"}]
  :note     "You need a free GitHub account. Everything there is public: leave out personal details, license keys and videos. GitHub tells you when we reply."}

 ;; For what shouldn't be public
 :business "EchoJustus.Studio@outlook.com"}
