 :open-source
 {:title "Software principal de código abierto"
  :lead  "Las herramientas y bibliotecas que desarrollamos en abierto. Lee el código, úsalo y envía issues y pull requests a cada proyecto."
  :projects
  {"clogem-hstry" {:subtitle "Historial de chats"
                   :about    "Una herramienta local-first para capturar, buscar y analizar historiales de chat."
                   :status   "En una fase temprana de desarrollo. Su código fuente aún no es público."}
   "clogem-press" {:subtitle "Bases de conocimiento, blogs y documentación"
                   :about    "Un generador de sitios para bases de conocimiento, blogs y documentación, con contenido en hasta cinco idiomas. Funciona con Babashka, sin ninguna otra dependencia."}
   "clogem-wmark" {:subtitle "Marcas de agua en vídeo, el núcleo abierto"
                   :about    "Marcas de agua por lotes en vídeos, que encarecen eliminarlas con IA: un logotipo que gira en 3D y textos de advertencia en momentos fijados por una clave. El motor, la línea de comandos y la interfaz web sobre los que se construye Wmark Pro."}}}

 :commercial
 {:title "Software comercial"
  :lead  "Aplicaciones creadas sobre el núcleo abierto, con una interfaz pensada para creadores. Cada una tiene su propia página de soporte y su política de privacidad."
