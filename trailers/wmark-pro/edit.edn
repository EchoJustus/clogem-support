;;
;; The cut of the Wmark Pro trailer (trailer.edit). Sources, by name: the
;; take (:take, recorded from recording.edn; its marks name the times), the
;; app's icon (:icon), and the copies the app rendered during the take with
;; its "Studio release" profile, named under :sources. Times are seconds, or
;; [mark offset] in the take. Card words are ids in words.edn; :upper cards
;; sit near the top, out of the app's way.
;;
;; The owner's direction (2026-10-05): the canary shown once or twice at
;; most; the batch shown by its progress bars, not the finished list; the
;; random spots set up in a close-up, then shown moving in a rendered copy,
;; never in the live preview; clean landscape footage. In these copies the
;; canary falls at 3.80 s and 9.81 s (orchard) and 5.64 s (clouds): every
;; part below stops short of them but the one held for its card.
{:crossfade 0.4
 :sources {:orchard "orchard_aerial_wm.mp4"
           :clouds  "steens_clouds_wm.mp4"}
 :segments
 [;; the result first: a watermarked time-lapse, the logo flipping, the
  ;; random text at its keyed moments (no canary before 5.64 s)
  {:id :open
   :parts [{:from :clouds :in 0.0 :out 5.5}]
   :cards [{:text :open :from 0.6 :until -0.45}]}

  {:id :title
   :title {:length 3.6
           :background {:from :clouds :at 3.0}
           :lines [{:word :name    :font :bold    :size 112 :color "white"    :y 560}
                   {:word :tagline :font :regular :size 50  :color "0xE6DEFF" :y 700}]}}

  ;; the app: a batch of two (the file dialog between the parts is cut)
  {:id :batch
   :parts [{:from :take :in [:start 0.6] :out [:add-videos 0.7]}
           {:from :take :in [:videos-added 0.1] :out [:scrub -0.2] :speed 1.25}]
   :cards [{:text :batch :from 0.5 :until -0.4 :place :upper}]}

  ;; scrubbing the preview: the logo flips at its keyed moments
  {:id :flip
   :zoom [176 34 1064 598]
   :parts [{:from :take :in [:scrub -0.1] :out [:scrub 7.3] :speed 1.6}]
   :cards [{:text :flip :sub :flip-sub :from 0.5 :until -0.4 :place :upper}]}

  ;; warning text, typed in and saved
  {:id :text
   :parts [{:from :take :in [:text -0.1] :out [:text-applied 1.0] :speed 1.6}]
   :cards [{:text :text :from 0.4 :until -0.4 :place :upper}]}

  ;; a close-up of the random layer: Position Random first, then three spots
  {:id :spots
   :zoom [900 380 1020 574]
   :parts [{:from :take :in [:spots 1.2] :out [:spots-set 0.5] :speed 1.4}]
   :cards [{:text :spots :sub :spots-sub :from 0.4 :until -0.4 :place :upper}]}

  ;; render the batch: the bars move, the wait sped up, cut before the list
  ;; of finished copies
  {:id :render
   :zoom [0 292 1400 788]
   :parts [{:from :take :in [:render -0.2] :out [:render 4.0]}
           {:from :take :in [:render 4.0] :out [:rendering 30.6] :speed 9}]
   :cards [{:text :render :sub :render-sub :from 0.5 :until -0.4 :place :upper}]}

  ;; a rendered copy plays: the random text moves among the chosen spots
  ;; (top left, top right, bottom centre); its one canary frame is held so
  ;; it can be read
  {:id :results
   :parts [{:from :orchard :in 0.6 :out 3.78}
           {:from :orchard :hold {:at 3.84 :for 2.4}}
           {:from :orchard :in 3.92 :out 9.70}]
   :cards [{:text :timing :from 0.3 :until 2.9}
           {:text :canary :sub :canary-sub :from 3.3 :until 5.5}]}

  {:id :end
   :title {:length 5.8
           :end? true
           :background {:from :clouds :at 8.0}
           :lines [{:word :name      :font :bold     :size 96 :color "white"    :y 390}
                   {:word :tagline   :font :regular  :size 44 :color "0xE6DEFF" :y 505}
                   {:word :try       :font :semibold :size 46 :color "0xFFE6B0" :y 610}
                   {:word :honest    :font :regular  :size 30 :color "0xD9D2F5" :y 700}
                   {:word :credits   :font :regular  :size 22 :color "0xB3A8DD" :y 850}
                   {:word :credits-2 :font :regular  :size 22 :color "0xB3A8DD" :y 884}]}}]}
